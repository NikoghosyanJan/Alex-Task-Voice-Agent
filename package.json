{
  "name": "taskbot",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @taskbot/web dev",
    "dev:worker": "pnpm --filter @taskbot/worker dev",
    "build": "pnpm db:generate && pnpm --filter @taskbot/web build && pnpm --filter @taskbot/worker build",
    "db:generate": "pnpm --filter @taskbot/db generate",
    "db:migrate": "pnpm --filter @taskbot/db migrate:dev",
    "db:deploy": "pnpm --filter @taskbot/db migrate:deploy",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "lint": "eslint . && pnpm --filter @taskbot/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "postinstall": "pnpm --filter @taskbot/db generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
