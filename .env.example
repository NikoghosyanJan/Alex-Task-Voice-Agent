# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Random string; Telegram sends it back in the X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=
# Bot username without @ (used for the "Open bot" link on the dashboard)
TELEGRAM_BOT_USERNAME=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TASK_MODEL=gpt-4o-mini

# --- Database (Neon) ---
# Pooled connection string (host contains "-pooler")
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection string, used only for migrations
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- Redis ---
# Local docker-compose overrides this with redis://redis:6379
# Upstash: rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379

# --- App ---
# Public base URL of the web app (production Vercel domain when deployed)
APP_URL=http://localhost:3000
# standalone = always-on worker (docker-compose / Vercel daemon), serverless = /api/worker/drain (Vercel previews)
WORKER_MODE=standalone
# Shared secret for /api/worker/drain
WORKER_SECRET=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# IANA timezone used to resolve relative due dates like "tomorrow at 5pm"
APP_TIMEZONE=UTC
LOG_LEVEL=info
